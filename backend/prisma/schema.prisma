generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  AGENT
  FRONTDESK
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         Role        @default(FRONTDESK)
  createdAt    DateTime    @default(now())
  complaints   Complaint[] @relation("CreatedBy")
}

model Hotel {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  departments Department[]
  complaints  Complaint[]
}

model Department {
  id         String      @id @default(cuid())
  name       String      @unique
  createdAt  DateTime    @default(now())
  complaints Complaint[]
  hotel      Hotel?      @relation(fields: [hotelId], references: [id])
  hotelId    String?
  // İleride aynı isim birden fazla otelde bulunsun istersen:
  // @@unique([name, hotelId])
}

model Complaint {
  id          String   @id @default(cuid())
  title       String
  description String
  status      Status   @default(OPEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String

  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])
  createdById String

  events      ComplaintEvent[]
  attachments Attachment[]

  hotel   Hotel?  @relation(fields: [hotelId], references: [id])
  hotelId String?
}

model ComplaintEvent {
  id          String   @id @default(cuid())
  type        String
  payloadJson Json?
  createdAt   DateTime @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id])
  complaintId String
}

model Attachment {
  id        String   @id @default(cuid())
  url       String
  type      String
  createdAt DateTime @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id])
  complaintId String
}
